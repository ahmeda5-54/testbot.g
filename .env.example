BOT_TOKEN=123456:ABC-DEF...
BOT_USERNAME=YourBot
ADMIN_IDS=111111111,222222222
CHANNEL_ID=-1001234567890
DEADLINE_HOURS=48
DASHBOARD_PASSWORD=change-me
# كلمة مرور صفحة المدير/البيع (خاصة بالبائع فقط — لا تظهر في واجهة المشتري)
# إن تُركت فارغة تُستخدم DASHBOARD_PASSWORD نفسها كبديل
MANAGER_PASSWORD
SECRET_KEY=change-me-random
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
# (اختياري) النطاق العام للوحة لبناء روابط الدخول المباشر للمشترين من القنوات
# والمجموعات — مثال: https://my-dashboard.up.railway.app
# إن تُرك فارغاً يُبنى الرابط تلقائياً من العنوان الذي يفتح به البائع الصفحة.
DASHBOARD_PUBLIC_URL=
# optional: local proxy to bypass Telegram blocking, e.g. http://127.0.0.1:7890
PROXY_URL=

# ── Licensing (trial/permanent activation codes) ──
# Configure the two activation codes above, then restart the application.
# Trial: 24 hours from first use; permanent: no expiry. Both are unlimited.

# UserBot (Telethon) sync — get api_id/api_hash from https://my.telegram.org/apps
TB_API_ID=
TB_API_HASH=
TB_PHONE=
TB_SESSION_NAME=members_session

# ── AI (channel trade analysis) ──
# provider: gemini | openai | mock   (openai = any OpenAI-compatible endpoint)
AI_PROVIDER=openai
AI_MODEL=google/gemini-2.5-flash
AI_VISION_MODEL=google/gemini-2.5-flash
AI_API_KEY=
# OpenAI-compatible endpoint override (OpenRouter/Groq...).
# OpenRouter: https://openrouter.ai/api/v1 — Gemini: https://generativelanguage.googleapis.com/v1beta
AI_BASE_URL=https://openrouter.ai/api/v1
AI_CONFIDENCE_THRESHOLD=0.90
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1024
AI_FALLBACK_KEYWORD=1
# per-symbol contract/point size for PnL computation (XAUUSD = gold)
# XAUUSD_CONTRACT_SIZE=100
# XAUUSD_POINT_SIZE=0.01
TRIAL_ACTIVATION_CODE=replace-with-your-private-trial-code
PERMANENT_ACTIVATION_CODE=replace-with-your-private-permanent-code
